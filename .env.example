# Only the local FastAPI server reads this key. Never prefix it with VITE_.
MODEL_API_BASE_URL=https://api.openai-next.com/v1
MODEL_API_KEY=
# 对话模型：glm-5.2（智谱，实测 2.7s）或 qwen-flash（实测 2.4s），两者都在中转站上
QWEN_TEXT_MODEL=glm-5.2
QWEN_TEXT_MODEL=qwen3.5-plus
QWEN_VISION_MODEL=qwen3-vl-flash
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICE=Serena
QWEN_TTS_SPEED=0.96
QWEN_TTS_INSTRUCTIONS=像关系很熟的年轻朋友一样自然说话，声音温暖、有一点俏皮，停顿自然，不要播音腔，不要夸张表演。
# 流式语音识别需要 DashScope 官方密钥（MODEL_API_KEY 是中转站密钥时无效）；有官方 key 时设为 1 启用
# VITE_REALTIME_ASR=0
